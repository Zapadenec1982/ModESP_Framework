{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://modesp.local/scenario_schema.json",
  "title": "ModESP Sequence Engine — scenario section schema",
  "description": "Validates the optional `scenario` section inside modules/<recipe>/manifest.json. See docs/sequence_engine/09_manifest_integration.md.",

  "type": "object",
  "required": ["default_phase_timeout_ms", "completion_rule", "tracks"],
  "additionalProperties": false,

  "properties": {
    "default_phase_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000,
      "description": "Fallback phase timeout (ms) applied when phase.timeout_ms is 0 or absent. Mandatory per ADR-0007."
    },
    "scenario_timeout_max_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2592000000,
      "description": "Hard scenario cap (ms). 0 = unlimited. Recommended for long-running recipes (greenhouse, ferment)."
    },
    "completion_rule": {
      "enum": ["all_tracks_complete", "any_track_complete", "main_track_complete"],
      "description": "Defines when scenario reaches COMPLETED state based on track outcomes."
    },
    "resources": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/definitions/resource" },
      "description": "Resources scenario claims at start (or per-phase). ISA-88 §5.3 arbitration."
    },
    "global_transitions": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/definitions/global_transition" },
      "description": "Transitions evaluated each tick across all tracks before per-phase transitions."
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/definitions/track" }
    },
    "params": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,30}$": { "$ref": "#/definitions/param" }
      },
      "additionalProperties": false,
      "description": "Recipe-scoped parameters referenceable from conditions/actions via @param:<name>."
    }
  },

  "definitions": {
    "resource": {
      "type": "object",
      "required": ["resource"],
      "additionalProperties": false,
      "properties": {
        "resource": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
          "maxLength": 32,
          "description": "Resource name (e.g. 'equipment.water_pump')."
        },
        "exclusive": {
          "type": "boolean",
          "default": true
        },
        "scope": {
          "enum": ["scenario", "phase"],
          "default": "scenario",
          "description": "scenario = claim at start; phase = claim per-phase entry."
        }
      }
    },

    "global_transition": {
      "type": "object",
      "required": ["to", "when"],
      "additionalProperties": false,
      "properties": {
        "to": { "$ref": "#/definitions/transition_target" },
        "when": { "$ref": "#/definitions/condition_expr" },
        "priority": {
          "type": "integer", "minimum": 0, "maximum": 255, "default": 100
        },
        "scope": {
          "enum": ["abort_scenario", "abort_only_main_track"],
          "default": "abort_scenario"
        }
      }
    },

    "track": {
      "type": "object",
      "required": ["name", "phases"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,7}$",
          "description": "Track name. Max 8 chars. Used for mirror state key prefix."
        },
        "flags": {
          "type": "array",
          "items": { "enum": ["main_track", "loop_on_complete"] },
          "uniqueItems": true,
          "default": []
        },
        "phases": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": { "$ref": "#/definitions/phase" }
        }
      }
    },

    "phase": {
      "type": "object",
      "required": ["name", "transitions"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,15}$",
          "maxLength": 16
        },
        "timeout_ms": {
          "type": "integer", "minimum": 0, "maximum": 86400000,
          "description": "Phase timeout. 0 = use scenario default_phase_timeout_ms."
        },
        "entry": {
          "type": "array",
          "items": { "$ref": "#/definitions/action_invocation" },
          "default": []
        },
        "exit": {
          "type": "array",
          "items": { "$ref": "#/definitions/action_invocation" },
          "default": []
        },
        "continuous": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "maxItems": 4,
          "description": "ContinuousBehavior names active during phase. MVP supports 0 built-ins; domain modules register own."
        },
        "transitions": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": { "$ref": "#/definitions/transition" }
        },
        "phase_resources": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["resource"],
            "additionalProperties": false,
            "properties": {
              "resource": { "type": "string", "maxLength": 32 },
              "exclusive": { "type": "boolean", "default": true }
            }
          },
          "description": "Phase-scope resource claims (acquired at entry, released at exit). See ADR-0005."
        }
      }
    },

    "transition": {
      "type": "object",
      "required": ["to"],
      "additionalProperties": false,
      "properties": {
        "to": { "$ref": "#/definitions/transition_target" },
        "when": { "$ref": "#/definitions/condition_expr" }
      },
      "description": "If `when` is absent → unconditional (fires immediately after phase entry actions)."
    },

    "transition_target": {
      "oneOf": [
        { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,15}$", "description": "Phase name within same track." },
        { "enum": ["$complete", "$abort"] }
      ]
    },

    "action_invocation": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{0,31}$",
          "description": "Action name (must resolve via known_actions.json or domain registration)."
        },
        "params": {
          "type": "object",
          "description": "Action-specific parameters. Schema not enforced here; validated at compile by action descriptor."
        },
        "fail_aborts": { "type": "boolean", "default": false },
        "fail_logs_only": { "type": "boolean", "default": false }
      }
    },

    "condition_expr": {
      "oneOf": [
        { "$ref": "#/definitions/cond_time_elapsed" },
        { "$ref": "#/definitions/cond_state_key_cmp" },
        { "$ref": "#/definitions/cond_state_key_in_range" },
        { "$ref": "#/definitions/cond_state_key_changed" },
        { "$ref": "#/definitions/cond_time_of_day" },
        { "$ref": "#/definitions/cond_all_of" },
        { "$ref": "#/definitions/cond_any_of" },
        { "$ref": "#/definitions/cond_not" }
      ]
    },

    "cond_time_elapsed": {
      "type": "object",
      "required": ["time_elapsed_ms"],
      "additionalProperties": false,
      "properties": {
        "time_elapsed_ms": { "type": "integer", "minimum": 0 }
      }
    },

    "cond_state_key_cmp": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^state_key_(eq|ne|lt|gt|le|ge)$": {
          "type": "object",
          "required": ["key", "value"],
          "additionalProperties": false,
          "properties": {
            "key": { "type": "string", "maxLength": 32 },
            "value": {
              "oneOf": [
                { "type": "number" },
                { "type": "boolean" },
                { "type": "string" }
              ]
            }
          }
        }
      },
      "minProperties": 1, "maxProperties": 1
    },

    "cond_state_key_in_range": {
      "type": "object",
      "required": ["state_key_in_range"],
      "additionalProperties": false,
      "properties": {
        "state_key_in_range": {
          "type": "object",
          "required": ["key", "min", "max"],
          "additionalProperties": false,
          "properties": {
            "key": { "type": "string", "maxLength": 32 },
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        }
      }
    },

    "cond_state_key_changed": {
      "type": "object",
      "required": ["state_key_changed"],
      "additionalProperties": false,
      "properties": {
        "state_key_changed": {
          "type": "object",
          "required": ["key"],
          "additionalProperties": false,
          "properties": {
            "key": { "type": "string", "maxLength": 32 }
          }
        }
      }
    },

    "cond_time_of_day": {
      "type": "object",
      "required": ["time_of_day_eq"],
      "additionalProperties": false,
      "properties": {
        "time_of_day_eq": {
          "type": "object",
          "required": ["hh", "mm"],
          "additionalProperties": false,
          "properties": {
            "hh": { "type": "integer", "minimum": 0, "maximum": 23 },
            "mm": { "type": "integer", "minimum": 0, "maximum": 59 }
          }
        }
      }
    },

    "cond_all_of": {
      "type": "object",
      "required": ["all_of"],
      "additionalProperties": false,
      "properties": {
        "all_of": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": { "$ref": "#/definitions/condition_expr" }
        }
      }
    },

    "cond_any_of": {
      "type": "object",
      "required": ["any_of"],
      "additionalProperties": false,
      "properties": {
        "any_of": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": { "$ref": "#/definitions/condition_expr" }
        }
      }
    },

    "cond_not": {
      "type": "object",
      "required": ["not"],
      "additionalProperties": false,
      "properties": {
        "not": { "$ref": "#/definitions/condition_expr" }
      }
    },

    "param": {
      "type": "object",
      "required": ["type", "default"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["i32", "f32", "bool"] },
        "default": {},
        "min": { "type": "number" },
        "max": { "type": "number" },
        "overridable": { "type": "boolean", "default": false }
      }
    }
  }
}

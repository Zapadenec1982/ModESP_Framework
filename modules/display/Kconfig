menu "ModESP Display"

    # Backend-и — це КОМПІЛЯЦІЙНІ перемикачі (як драйвери): вмикають збірку коду
    # backend-у. АКТИВНИЙ backend обирається у bindings.json (поле "driver" на
    # role у module "display"), а піни/шина/геометрія — з board.json. Без binding
    # дисплея використовується LogPort (View у серійний лог, робота без заліза).
    # Кілька backend-ів можна збирати одночасно — board обере потрібний.

    config MODESP_DISPLAY_AT7456E
        bool "Build AT7456E backend (composite video OSD overlay)"
        default n
        help
            AT7456E (MAX7456-сумісний OSD-чіп) накладає символьну сітку на
            аналоговий composite-відеосигнал. Потребує відеомонітор на CVBS.
            Активувати: bindings.json driver "at7456e".
            ⚠ SPI-піни наразі тут (Kconfig). TODO: перенести у board.json
              (секція spi_buses), як AMT630A вже на board.json i2c_buses.

    if MODESP_DISPLAY_AT7456E

        config MODESP_DISPLAY_AT7456E_CS
            int "CS GPIO"
            default 5

        config MODESP_DISPLAY_AT7456E_MOSI
            int "DATA/MOSI GPIO"
            default 23

        config MODESP_DISPLAY_AT7456E_CLK
            int "CLK GPIO"
            default 18

        config MODESP_DISPLAY_AT7456E_MISO
            int "MISO GPIO"
            default 19

        choice MODESP_DISPLAY_AT7456E_STD
            prompt "Video standard"
            default MODESP_DISPLAY_AT7456E_PAL
            config MODESP_DISPLAY_AT7456E_PAL
                bool "PAL (16 rows)"
            config MODESP_DISPLAY_AT7456E_NTSC
                bool "NTSC (13 rows)"
        endchoice

        choice MODESP_DISPLAY_AT7456E_SYNC
            prompt "Sync source"
            default MODESP_DISPLAY_AT7456E_SYNC_AUTO
            help
                internal — власний sync (екран горить без вхідного відео);
                auto — internal лише при втраті вхідного sync;
                external — тримати вхідний sync.
            config MODESP_DISPLAY_AT7456E_SYNC_AUTO
                bool "auto"
            config MODESP_DISPLAY_AT7456E_SYNC_INTERNAL
                bool "internal"
            config MODESP_DISPLAY_AT7456E_SYNC_EXTERNAL
                bool "external"
        endchoice

    endif

    config MODESP_DISPLAY_AMT630A
        bool "Build AMT630A backend (I2C OSD/TFT video-SoC)"
        default n
        help
            AMT630A video-SoC керується ззовні по I²C поверх заводської прошивки
            (Шлях A). OSD/меню/колір/вибір CVBS-входу на TFT.
            Активувати: bindings.json driver "amt630a" на hardware з board.json
            секції i2c_displays. Піни/швидкість — board.json i2c_buses; сітка
            cols×rows — board.json i2c_displays. ЖОДНИХ пінів у Kconfig.

endmenu

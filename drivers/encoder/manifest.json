{
  "manifest_version": 1,
  "driver": "encoder",
  "description": "Інкрементальний поворотний енкодер (квадратурний A/B). Кнопка — окремий digital_input.",
  "category": "sensor",
  "hardware_type": "encoder",
  "requires_address": false,
  "multiple_per_bus": false,
  "provides": {"type": "float"},
  "settings": [
    {"key": "steps_per_detent", "type": "int", "default": 4, "min": 1, "max": 4, "description": "Квадратурних переходів на один клац (детент)", "persist": true},
    {"key": "invert", "type": "bool", "default": false, "description": "Інверсія напрямку обертання", "persist": true}
  ]
}

menu "ModESP Audio"

    # Sink backends are COMPILATION switches (like display backends): they enable
    # building the backend code. The ACTIVE sink is chosen in bindings.json (field
    # "driver" on role audio_main, module "player"); pins/sample-rate — board.json
    # i2s_buses. Without a binding the player uses NullSink (silent). Several
    # backends may be built at once — the board picks one.

    config MODESP_AUDIO_MAX98357A
        bool "Build MAX98357A I2S audio sink"
        default n
        help
            MAX98357A I²S Class-D mono amplifier as the audio output sink.
            Activate: bindings.json driver "max98357a" on hardware from board.json
            section i2s_buses (role audio_main, module player). Pins/sample-rate —
            board.json i2s_buses. No pins in Kconfig.

    config MODESP_AUDIO_MP3
        bool "MP3 clip playback (libhelix)"
        default y
        help
            Decode .mp3 clips from /data/audio/ via libhelix (esp-libhelix-mp3,
            fixed-point source decoder). When disabled, only WAV (16-bit PCM mono)
            clips play and .mp3 requests are rejected; the decoder code and the
            libhelix dependency are dropped from the binary.

endmenu

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "modesp/driver.schema.json",
  "title": "ModESP driver manifest",
  "type": "object",
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "driver": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 16
    },
    "category": {
      "enum": [
        "sensor",
        "actuator",
        "io",
        "display",
        "audio"
      ]
    },
    "hardware_type": {
      "type": "string"
    },
    "transport": {
      "enum": ["wired", "ble", "lora", "mqtt", "espnow"],
      "description": "Transport family (default derived from hardware_type). Orthogonal to the bus/hw_type so LoRa/MQTT/ESP-NOW do not overload hardware_type."
    },
    "provides": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "unit": { "type": "string" },
        "range": {},
        "description": { "type": "string" },
        "capability": {
          "type": "string",
          "description": "Capability of a single-value driver (∈ tools/capabilities.json). Multi-channel drivers use provides.channels[] or address_channels[].capability instead."
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "channel": { "type": "string" },
              "capability": { "type": "string" },
              "unit": { "type": "string" },
              "label": { "type": "string" }
            },
            "required": ["channel", "capability"],
            "patternProperties": { "^_": {} },
            "additionalProperties": false
          }
        }
      }
    },
    "requires_address": {
      "type": "boolean"
    },
    "connect_name_prefix": {
      "type": "string",
      "description": "BLE connect device: adv-name prefix matched by the transport for the unified scan."
    },
    "address_channels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": { "type": "string" },
          "label": { "type": "string" },
          "capability": {
            "type": "string",
            "description": "Capability of this channel (∈ tools/capabilities.json) — back-compat per-channel path; provides.channels[] is the recommended form."
          }
        },
        "required": ["value", "label"],
        "patternProperties": { "^_": {} },
        "additionalProperties": false
      }
    },
    "multiple_per_bus": {
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "type": {
            "enum": [
              "float",
              "int",
              "bool"
            ]
          },
          "default": {},
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "persist": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "type",
          "default"
        ],
        "patternProperties": {
          "^_": {}
        },
        "additionalProperties": false
      }
    },
    "ui": {
      "type": "object"
    },
    "discovery": {
      "type": "object"
    }
  },
  "required": [
    "manifest_version",
    "driver",
    "category",
    "hardware_type",
    "provides"
  ],
  "patternProperties": {
    "^_": {}
  },
  "additionalProperties": false
}

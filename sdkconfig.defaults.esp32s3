# ── ESP32-S3 target overlay (auto-applied by ESP-IDF on top of sdkconfig.defaults
#    when IDF_TARGET=esp32s3). ──
#
# This overlay only picks the DEFAULT board for a fresh esp32s3 sdkconfig. All
# board-specific config (flash size, partition table, BLE, radio tuning) now lives
# in the board's own profile: boards/<board>/sdkconfig.board, which CMakeLists.txt
# applies for whichever board is active. So a new S3 board = a new boards/<name>/
# folder (board.json + bindings.json + sdkconfig.board) with zero edits here.
#
# Select a different board in `idf.py menuconfig` → "ModESP Configuration".
CONFIG_MODESP_BOARD_STAND_S3=y

{
  "manifest_version": 1,
  "board": "stand_s3",
  "version": "1.0.0",
  "description": "Тестовий стенд ESP32-S3 + AMT630A (ZCD-630A-4.3D). I2C SDA=GPIO6/SCL=GPIO5. ⚠ idf.py set-target esp32s3 (на класичному ESP32 GPIO6 — flash-пін).",
  "i2c_buses": [
    {"id": "i2c_0", "sda": 6, "scl": 5, "freq_hz": 100000, "label": "I2C (AMT630A; розширювана — тюнер/PCF8574 за потреби)"}
  ],
  "i2c_displays": [
    {"id": "disp_0", "bus": "i2c_0", "chip": "amt630a", "cols": 20, "rows": 10, "label": "AMT630A OSD/TFT (ZCD-630A-4.3D)"}
  ],
  "i2s_buses": [
    {"id": "i2s_0", "bclk": 15, "ws": 16, "dout": 7, "sd": 17, "sample_rate_hz": 16000, "label": "MAX98357A аларм-сигналізатор (SD=GPIO17 hardware-mute)"}
  ],
  "uart_buses": [
    {"id": "uart_1", "port": 1, "rx": 18, "tx": 8, "baud": 256000, "label": "LD2410B mmWave радар присутності (RX=18←sensorTX, TX=8→sensorRX опц.)"}
  ],
  "ble_devices": [
    {"id": "xiaomi_room", "mac": "a4:c1:38:b4:dc:11", "format": "auto", "label": "Xiaomi LYWSD03MMC (pvvx/BTHome) — temp/hum/battery"},
    {"id": "led_panel", "name": "LED_BLE_E6C5EBE2", "label": "iPixel Color 16x64 LED matrix (connect device)"}
  ]
}

{
  "manifest_version": 1,
  "driver": "ld2410b",
  "description": "HLK-LD2410B 24GHz mmWave радар присутності (UART 256000)",
  "category": "sensor",
  "hardware_type": "uart_bus",
  "requires_address": false,
  "multiple_per_bus": true,
  "provides": {"type": "float", "description": "presence 0/1, або дистанція (см) / енергія (0-100) залежно від address-каналу"},
  "_address_channels": {
    "_note": "Поле 'address' у bindings обирає, яку величину віддає read(). Один фізичний LD2410b (одна UART-шина) може живити кілька ролей з різними address.",
    "": "presence — є ціль (0/1), default",
    "presence": "є ціль рух+статика (0/1)",
    "moving": "дистанція рухомої цілі, см",
    "static": "дистанція статичної цілі, см",
    "detect": "дистанція виявлення, см",
    "moving_energy": "енергія рухомої цілі, 0-100",
    "static_energy": "енергія статичної цілі, 0-100"
  },
  "_config_note": "absence_s/max_cm/move_sens/still_sens пишуться В датчик командами при init (потрібен MCU TX → sensor RX). Зберігаються у флеші датчика. timeout_ms — суто драйверний (детект несправності).",
  "settings": [
    {"key": "absence_s",   "type": "int", "default": 1,    "min": 0,   "max": 600,   "step": 1,   "unit": "с",  "description": "Затримка зникнення присутності (конфіг датчика — швидкість реакції)", "persist": true},
    {"key": "max_cm",      "type": "int", "default": 600,  "min": 75,  "max": 600,   "step": 75,  "unit": "см", "description": "Макс. дистанція виявлення — ігнорувати далі (квантовано по 0.75 м, gate 1..8 = 75..600 см)", "persist": true},
    {"key": "move_sens",   "type": "int", "default": 0,    "min": 0,   "max": 100,   "step": 5,   "unit": "",   "description": "Поріг чутливості рух (0 = не чіпати; вище = менш чутливо)", "persist": true},
    {"key": "still_sens",  "type": "int", "default": 0,    "min": 0,   "max": 100,   "step": 5,   "unit": "",   "description": "Поріг чутливості статика (0 = не чіпати; підняти проти фантомної присутності)", "persist": true},
    {"key": "timeout_ms",  "type": "int", "default": 2000, "min": 200, "max": 10000, "step": 100, "unit": "мс", "description": "Без кадру довше — датчик несправний", "persist": true}
  ],
  "ui": {
    "page": "Налаштування датчиків",
    "page_id": "driver_settings",
    "access_level": "service",
    "cards": [
      {
        "title": "LD2410b: {{hardware_id}}",
        "instance_per_binding": true,
        "widgets": [
          {"setting": "absence_s",   "widget": "number_input"},
          {"setting": "max_cm",      "widget": "slider"},
          {"setting": "move_sens",   "widget": "slider"},
          {"setting": "still_sens",  "widget": "slider"},
          {"setting": "timeout_ms",  "widget": "number_input"}
        ]
      }
    ]
  }
}
